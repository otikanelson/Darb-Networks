{
  "name": "darb-network",
  "private": true,
  "version": "1.0.0",
  "description": "Darb Network - Crowdfunding Platform",
  "type": "module",
  "homepage": "https://darbnetwork.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/otikanelson/darb-network.git"
  },
  "author": {
    "name": "Darb Network Team",
    "email": "dev@darbnetwork.com"
