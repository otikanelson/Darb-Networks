# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=darb_network

# Firebase Admin SDK Configuration
# Get these from your Firebase project's Service Account JSON file
# (Project Settings → Service Accounts → Generate new private key)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQE...\n-----END PRIVATE KEY-----\n

# JWT Secret (REQUIRED - must be at least 32 characters for security)
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Node Environment
NODE_ENV=development

# Server Port
PORT=5000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# CORS configuration
# Comma-separated list of allowed origins (always includes localhost:5173 in development)
ALLOWED_ORIGINS=https://darb-network.vercel.app

# Optional: Regex pattern for Vercel preview URLs (e.g. "https://darb-network-.*\\.vercel\\.app")
# If not set, Vercel preview URLs are not allowed. For production, leave empty or commented out.
# VERCEL_PREVIEW_PATTERN=https://darb-network-[a-z0-9]+-preview\\.vercel\\.app

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Paystack Configuration (for payments)
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# reCAPTCHA Configuration (for signup protection) - DEPRECATED, using Firebase now
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
# RECAPTCHA_PUBLIC_KEY=your_recaptcha_public_key
